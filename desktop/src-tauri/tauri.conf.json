{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "reliontree",
  "version": "0.1.0",
  "identifier": "com.reliontree.app",
  "build": { "frontendDist": "../ui" },
  "app": {
    "withGlobalTauri": true,
    "windows": [{ "label": "start", "title": "reliontree", "width": 520, "height": 620 }],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "externalBin": ["binaries/reliontree-cli"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"]
  }
}
