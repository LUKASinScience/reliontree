#%Module1.0
## Tcl modulefile (classic Environment Modules) — equivalent to 0.1.0.lua
## for sites running Tcl modules instead of Lmod. Lmod also reads this
## format, but prefers the .lua file when both exist for the same version.

proc ModulesHelp { } {
    puts stderr "reliontree — standalone RELION job-lineage viewer."
    puts stderr "No ChimeraX, no third-party server framework, no GUI toolkit."
    puts stderr ""
    puts stderr "This module only adds the reliontree command to PATH -- every"
    puts stderr "subcommand and option works exactly as documented at"
    puts stderr "https://github.com/LUKASinScience/reliontree, nothing cluster-specific."
    puts stderr ""
    puts stderr "Usage:"
    puts stderr "  cd /path/to/your/relion_project"
    puts stderr "  reliontree                          zero-config: opens the live view"
    puts stderr "  reliontree tree . --format json      machine-readable job graph"
    puts stderr "  reliontree table . --format csv      job history as a table"
    puts stderr "  reliontree watch . --port 8710       live view with explicit options"
    puts stderr ""
    puts stderr "See 'reliontree --help' (and 'reliontree <subcommand> --help') once loaded."
}

module-whatis "Standalone RELION job-lineage viewer (no ChimeraX, no third-party server framework)"

# Edit this to wherever contrib/modules/install.sh installed reliontree's
# venv on this cluster.
set install_dir /path/to/shared/apps/reliontree/0.1.0 ;# <-- edit for your site

prepend-path PATH $install_dir/bin
